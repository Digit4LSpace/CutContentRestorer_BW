	<!--
	  ModThatIsNotMod - the de facto standard BONEWORKS utility mod
	  (custom items, BoneMenu, grab/gun-fire events, etc.) - lives in the
	  Mods folder, not the game's own assembly folder, so the wizard's
	  auto-detected reference set above doesn't include it - added
	  manually here instead. Requires ModThatIsNotMod to already be
	  installed at $(GamePath)/Mods/ModThatIsNotMod.dll.
	-->
	<ItemGroup>
		<Reference Include="ModThatIsNotMod">
			<HintPath>$(GamePath)/Mods/ModThatIsNotMod.dll</HintPath>
		</Reference>
	</ItemGroup>

	<PropertyGroup>
